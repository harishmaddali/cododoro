{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cododoro",
  "version": "0.1.0",
  "identifier": "com.cododoro.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 400,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Daily commit goals via the GitHub CLI",
    "longDescription": "cododoro tracks your daily commit goal using the local gh CLI and nudges you with notifications.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/harishmaddali/cododoro/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzQzY5RDgyQjk0MTA0NzQKUldSMEJFRzVncDNHTXpuUkRwNGM3Q242QmJJcWtzc1krckVPZERnUnYxQ2czN241am9mSHpBVUcK"
    }
  }
}
