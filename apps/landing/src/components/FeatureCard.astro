---
interface Props {
  title: string;
  body: string;
  icon?: string;
}

const { title, body, icon = "•" } = Astro.props;
---

<article class="card flex flex-col gap-3">
  <div
    class="w-10 h-10 rounded-md bg-bg-3 border border-line flex items-center justify-center text-grass-4 text-lg font-mono"
    aria-hidden="true"
  >
    {icon}
  </div>
  <h3 class="text-[17px] font-semibold tracking-[-0.01em] text-fg-0">{title}</h3>
  <p class="text-[14px] leading-relaxed text-fg-1">{body}</p>
</article>
