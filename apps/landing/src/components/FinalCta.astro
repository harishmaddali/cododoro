---
import HeroDownload from "./HeroDownload.astro";
---

<section class="relative overflow-hidden text-center" style="padding: 100px 0;">
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(57,216,120,0.1), transparent 70%);"
  >
  </div>
  <div class="container-page relative">
    <h2
      class="font-semibold tracking-[-0.03em] leading-[1.05] m-0"
      style="font-size: clamp(36px, 5vw, 56px);"
    >
      One push away.
    </h2>
    <p class="text-fg-1 mt-[18px] relative" style="font-size: 17px;">Free. No account. No email.</p>
    <div class="mt-8 flex justify-center gap-3 flex-wrap">
      <HeroDownload variant="final" showDropdown={false} />
    </div>
  </div>
</section>
