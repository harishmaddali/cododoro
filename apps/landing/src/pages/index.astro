---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import OpenSource from "../components/OpenSource.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import { getLatestDownloads } from "../lib/github-releases";

const downloads = await getLatestDownloads();
const year = new Date().getFullYear();
---

<Base title="Cododoro — desktop app for daily commit goals">
  <Nav version={downloads.version} />
  <main class="flex-1">
    <Hero version={downloads.version} />
    <Features />
    <OpenSource />
    <FinalCta />
  </main>
  <Footer version={downloads.version} year={year} />
</Base>

<script>
  import "../lib/download-controls";
</script>
