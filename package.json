{
  "name": "@cododoro/root",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:desktop": "pnpm -F @cododoro/desktop-app dev",
    "dev:landing": "pnpm -F @cododoro/landing dev",
    "build:desktop": "pnpm -F @cododoro/desktop-app build",
    "build:landing": "pnpm -F @cododoro/landing build",
    "tauri": "pnpm -F @cododoro/desktop-app tauri",
    "typecheck": "pnpm -r run typecheck",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check"
  },
