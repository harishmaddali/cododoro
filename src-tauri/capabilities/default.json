{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permission set for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "store:default",
    "opener:default",
    "updater:default",
    "process:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/*" }]
    }
  ]
}
