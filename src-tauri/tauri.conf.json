{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Codeodoro",
  "version": "0.1.0",
  "identifier": "com.codeodoro.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 420,
        "height": 620,
        "minWidth": 380,
        "minHeight": 500,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Daily commit goals via the GitHub CLI",
    "longDescription": "Codeodoro tracks your daily commit goal using the local gh CLI and nudges you with notifications."
  }
}
